<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher glyph: a clock with a big "1" over an open book ("one minute" of language). White on transparent,
     so it also works as the themed (monochrome) icon. Everything stays inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Clock ring, open at the bottom where the book covers it (keeps the spine gap clean). -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:pathData="M39.72,64A20,20 0,1 1,68.28 64" />
    <!-- Hour marks at 12, 3 and 9. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M52.5,34a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0z M66.5,50a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0z M38.5,50a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0z" />
    <!-- The "1". -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M48.5,42.5L55,38V57.5" />
    <!-- Open book; the gap between the pages is the spine. It covers the bottom of the ring. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M53,65C47.5,61.5 40.5,61 33,63V77C40.5,75 47.5,75.5 53,79Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M55,65C60.5,61.5 67.5,61 75,63V77C67.5,75 60.5,75.5 55,79Z" />
</vector>
