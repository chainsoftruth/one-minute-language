<?xml version="1.0" encoding="utf-8"?>
<!-- One UI-style frosted panel: pale lilac to blush, a thin white edge, large corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/widget_bg_start"
        android:endColor="@color/widget_bg_end" />
    <stroke android:width="1dp" android:color="@color/widget_edge" />
    <corners android:radius="28dp" />
</shape>
