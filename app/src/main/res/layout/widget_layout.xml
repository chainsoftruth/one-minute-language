<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp"
    android:background="@drawable/widget_mesh_gradient">

    <ViewFlipper
        android:id="@+id/word_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inAnimation="@anim/slide_up_in"
        android:outAnimation="@anim/slide_up_out"
        android:measureAllChildren="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/article_a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="2dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="1dp"
                android:text=""
                android:textColor="@color/widget_tag_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/primary_text_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Het woord"
                android:textColor="@color/widget_text"
                android:textSize="28sp"
                android:gravity="center"
                android:textAlignment="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />

            <TextView
                android:id="@+id/secondary_text_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="The word"
                android:textColor="@color/widget_text"
                android:textSize="18sp"
                android:gravity="center"
                android:textAlignment="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/article_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="2dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="1dp"
                android:text=""
                android:textColor="@color/widget_tag_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/primary_text_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/widget_text"
                android:textSize="28sp"
                android:gravity="center"
                android:textAlignment="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />

            <TextView
                android:id="@+id/secondary_text_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text=""
                android:textColor="@color/widget_text"
                android:textSize="18sp"
                android:gravity="center"
                android:textAlignment="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />
        </LinearLayout>
    </ViewFlipper>

    <TextView
        android:id="@+id/btn_add_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:paddingTop="0dp"
        android:paddingEnd="6dp"
        android:text="+"
        android:textColor="@color/widget_text"
        android:textSize="26sp" />

</FrameLayout>
