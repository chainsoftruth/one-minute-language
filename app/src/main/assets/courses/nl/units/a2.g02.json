  "lessons": [
    {
      "id": "a2.g02.l1", "title": "hebben or zijn?", "kind": "grammar",
      "explain": [
        { "type": "p", "text": "Most verbs use **hebben** in the perfect tense. Use **zijn** when the verb means **going somewhere** (a direction or goal) or **a change of state**. Typical **zijn** verbs: *gaan, komen, blijven, worden, zijn, beginnen, vertrekken, gebeuren, sterven*." },
        { "type": "table", "head": ["infinitive", "perfect with zijn"], "rows": [["gaan", "is gegaan"], ["komen", "is gekomen"], ["blijven", "is gebleven"], ["worden", "is geworden"], ["zijn", "is geweest"], ["beginnen", "is begonnen"], ["vertrekken", "is vertrokken"], ["gebeuren", "is gebeurd"]] },
        { "type": "ex", "nl": "Ik ben gisteren naar Utrecht gegaan.", "en": "Yesterday I went to Utrecht." },
        { "type": "p", "text": "Some verbs can take both. The activity itself uses **hebben**; movement towards a **goal** uses **zijn**. Compare: *Ik heb een uur gefietst* (an activity) and *Ik ben naar mijn werk gefietst* (to a place)." },
        { "type": "ex", "nl": "Zij is ziek geweest.", "en": "She has been ill." },
        { "type": "tip", "text": "Not sure? Ask yourself: is there a **place I am going to** or a **change**? If so, take **zijn**. For everything else take **hebben**." }
      ],
      "items": [
        { "type": "choice", "q": "Ik ___ gisteren naar Utrecht gegaan.", "options": ["ben", "heb", "is"], "answer": 0 },
        { "type": "choice", "q": "Zij ___ hier drie jaar gewoond.", "options": ["heeft", "is", "ben"], "answer": 0 },
        { "type": "choice", "q": "De trein ___ al vertrokken.", "options": ["is", "heeft", "hebben"], "answer": 0 },
        { "type": "choice", "q": "Ik ___ een uur gefietst.", "options": ["heb", "ben", "is"], "answer": 0, "explain": "There is no goal here, only an activity: hebben." },
        { "type": "choice", "q": "Ik ___ naar mijn werk gefietst.", "options": ["ben", "heb", "heeft"], "answer": 0, "explain": "There is a goal (naar mijn werk): zijn." },
        { "type": "gap", "text": "Ik ___ gisteren in Rotterdam geweest.", "answers": ["ben"], "en": "Yesterday I was in Rotterdam." },
        { "type": "gap", "text": "De les ___ om negen uur begonnen.", "answers": ["is"], "en": "The lesson started at nine o'clock." },
        { "type": "gap", "text": "Wij ___ zaterdag thuis gebleven.", "answers": ["zijn"], "en": "We stayed at home on Saturday." },
        { "type": "gap", "text": "Hij ___ vorig jaar ziek geworden.", "answers": ["is"], "en": "He became ill last year." },
        { "type": "gap", "text": "Wij ___ gisteren pasta gegeten.", "answers": ["hebben"], "en": "We ate pasta yesterday.", "explain": "Eten is not about going somewhere: hebben." },
        { "type": "transform", "q": "Ik ga naar huis.", "instruction": "Make it perfect tense", "answers": ["Ik ben naar huis gegaan"] },
        { "type": "transform", "q": "Hij komt te laat.", "instruction": "Make it perfect tense", "answers": ["Hij is te laat gekomen"] },
        { "type": "transform", "q": "Wij blijven thuis.", "instruction": "Make it perfect tense", "answers": ["Wij zijn thuis gebleven", "We zijn thuis gebleven"] },
        { "type": "order", "answer": "Ik ben gisteren naar Utrecht gegaan.", "alt": ["Gisteren ben ik naar Utrecht gegaan."], "en": "Yesterday I went to Utrecht." },
        { "type": "order", "answer": "De trein is net vertrokken.", "en": "The train has just left." },
        { "type": "translate", "en": "I went to Amsterdam yesterday.", "answers": ["Ik ben gisteren naar Amsterdam gegaan", "Gisteren ben ik naar Amsterdam gegaan"] },
        { "type": "translate", "en": "She has been ill.", "answers": ["Zij is ziek geweest", "Ze is ziek geweest"] },
        { "type": "match", "pairs": [["gaan", "is gegaan"], ["komen", "is gekomen"], ["blijven", "is gebleven"], ["worden", "is geworden"]] }
      ],
      "sources": [
