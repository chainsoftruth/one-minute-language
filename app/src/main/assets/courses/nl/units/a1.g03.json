        { "type": "translate", "en": "Where is he going?", "answers": ["Waar gaat hij naartoe", "Waar gaat hij heen", "Waar gaat hij naar toe", "Waar gaat hij"] },
        { "type": "translate", "en": "What are you reading? (informal)", "answers": ["Wat lees je", "Wat lees jij"] }
      ],
