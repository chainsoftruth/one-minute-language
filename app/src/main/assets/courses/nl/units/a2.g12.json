    {
      "id": "a2.g12.l2", "title": "nog niet, niet meer, nooit, niemand, niets, nergens", "kind": "grammar",
      "explain": [
        { "type": "p", "text": "Combine *niet* and *geen* with other words: **nog niet** (not yet), **niet meer** (not any more), **geen … meer** (no … left, no more). And learn four negative words: **nooit** (never), **niemand** (nobody), **niets** (nothing), **nergens** (nowhere). They go where an object or an adverb would go." },
        { "type": "table", "head": ["word", "meaning", "example"], "rows": [["nog niet", "not yet", "Ik heb nog niet gegeten."], ["niet meer", "not any more", "Zij werkt hier niet meer."], ["geen … meer", "no more", "Wij hebben geen brood meer."], ["nooit", "never", "Ik drink nooit koffie."], ["niemand", "nobody", "Ik heb niemand gezien."], ["niets", "nothing", "Zij heeft niets gezegd."], ["nergens", "nowhere", "Ik kan mijn sleutels nergens vinden."]] },
        { "type": "ex", "nl": "Ik heb niemand gezien.", "en": "I did not see anybody." },
        { "type": "ex", "nl": "Wij hebben geen brood meer.", "en": "We have no more bread." },
        { "type": "tip", "text": "Dutch does **not** use a double negative like English *I didn't see nobody*. One negative word is enough: *Ik heb niemand gezien.*" }
      ],
      "items": [
        { "type": "choice", "q": "Ik heb ___ gegeten. (not yet)", "options": ["nog niet", "niet meer", "nooit"], "answer": 0 },
        { "type": "choice", "q": "Ik werk daar ___. (not any more)", "options": ["niet meer", "nog niet", "nooit"], "answer": 0 },
        { "type": "choice", "q": "Ik heb geen tijd ___.", "options": ["meer", "nog", "niet"], "answer": 0 },
        { "type": "choice", "q": "Ik zie ___. (nobody)", "options": ["niemand", "niets", "nergens"], "answer": 0 },
        { "type": "gap", "text": "Ik drink ___ koffie. (never)", "answers": ["nooit"], "en": "I never drink coffee." },
        { "type": "gap", "text": "Ik zie ___. (nothing)", "answers": ["niets"], "en": "I see nothing." },
        { "type": "gap", "text": "Zij heeft ___ gezien. (nobody)", "answers": ["niemand"], "en": "She has not seen anybody." },
        { "type": "gap", "text": "Ik kan mijn sleutels ___ vinden. (nowhere)", "answers": ["nergens"], "en": "I cannot find my keys anywhere." },
        { "type": "gap", "text": "Hij werkt hier ___ meer. (not)", "answers": ["niet"], "en": "He does not work here any more." },
        { "type": "gap", "text": "Wij hebben ___ geld meer. (no)", "answers": ["geen"], "en": "We have no money left." },
        { "type": "gap", "text": "Hij heeft het ___ gedaan. (not yet)", "answers": ["nog niet"], "en": "He has not done it yet." },
        { "type": "gap", "text": "Zij heeft ___ gezegd. (nothing)", "answers": ["niets"], "en": "She has said nothing." },
        { "type": "transform", "q": "Ik heb gegeten.", "instruction": "Say: not yet", "answers": ["Ik heb nog niet gegeten"] },
        { "type": "transform", "q": "Ik werk daar.", "instruction": "Say: not any more", "answers": ["Ik werk daar niet meer"] },
        { "type": "transform", "q": "Wij hebben tijd.", "instruction": "Say: no time left (geen ... meer)", "answers": ["Wij hebben geen tijd meer", "We hebben geen tijd meer"] },
        { "type": "transform", "q": "Ik heb iemand gezien.", "instruction": "Say: nobody", "answers": ["Ik heb niemand gezien"] },
        { "type": "order", "answer": "Ik heb nog niet gegeten.", "en": "I have not eaten yet." },
        { "type": "order", "answer": "Zij werkt hier niet meer.", "en": "She does not work here any more." },
        { "type": "order", "answer": "Ik heb niemand gezien.", "en": "I did not see anybody." },
        { "type": "order", "answer": "Ik kan mijn sleutels nergens vinden.", "en": "I cannot find my keys anywhere." },
        { "type": "translate", "en": "I never drink coffee.", "answers": ["Ik drink nooit koffie"] },
        { "type": "translate", "en": "I did not hear anything.", "answers": ["Ik heb niets gehoord", "Ik hoorde niets"] },
        { "type": "translate", "en": "He is not here any more.", "answers": ["Hij is hier niet meer"] },
        { "type": "translate", "en": "We have no more bread.", "answers": ["Wij hebben geen brood meer", "We hebben geen brood meer"] },
        { "type": "match", "pairs": [["nooit", "never"], ["niemand", "nobody"], ["niets", "nothing"], ["nergens", "nowhere"]] }
