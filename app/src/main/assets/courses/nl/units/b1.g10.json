        { "type": "translate", "en": "He took an umbrella with him.", "answers": ["Hij nam een paraplu mee", "Hij heeft een paraplu meegenomen"] },
        { "type": "translate", "en": "I forgot to call her.", "answers": ["Ik ben vergeten haar op te bellen", "Ik ben vergeten haar te bellen", "Ik vergat haar op te bellen", "Ik vergat haar te bellen"] },
