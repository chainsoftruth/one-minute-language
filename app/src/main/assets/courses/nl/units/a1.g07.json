        { "type": "choice", "q": "Ik zie ___ niet. (him)", "options": ["hij", "hem", "zijn"], "answer": 1 },
        { "type": "choice", "q": "___ boek (that)", "options": ["dat", "die", "deze"], "answer": 0 },
        { "type": "gap", "text": "Zij woont met ___ man in Leiden. (her)", "answers": ["haar"], "en": "She lives with her husband in Leiden." },
        { "type": "gap", "text": "Mijn buren hebben een hond. ___ hond is groot. (their)", "answers": ["Hun"], "en": "My neighbours have a dog. Their dog is big." },
        { "type": "gap", "text": "Ik zie ___. Hij staat bij de deur. (him)", "answers": ["hem"], "en": "I see him. He is standing at the door." },
