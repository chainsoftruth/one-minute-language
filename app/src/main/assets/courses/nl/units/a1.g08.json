        { "type": "choice", "q": "de ___ kinderen (small)", "options": ["klein", "kleine"], "answer": 1 },
        { "type": "choice", "q": "Het eten is ___. (good)", "options": ["goed", "goede"], "answer": 0 },
        { "type": "gap", "text": "Dit is een ___ stoel. (mooi)", "answers": ["mooie"], "en": "This is a beautiful chair." },
