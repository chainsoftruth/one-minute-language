        { "type": "translate", "en": "The new teacher is nice.", "answers": ["De nieuwe leraar is aardig", "De nieuwe lerares is aardig"] },
        { "type": "translate", "en": "I have a nice job.", "answers": ["Ik heb leuk werk", "Ik heb een leuke baan"] },
        { "type": "translate", "en": "Where is the green bag?", "answers": ["Waar is de groene tas"] }
      ],
      "sources": [
